{
  "name": "portal-gampong",
  "version": "1.0.0",
  "description": "Portal Digital Gampong",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^9.4.4",
    "electron-builder": "^22.14.13"
  },
  "build": {
    "appId": "com.gampong.portal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["ia32"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}